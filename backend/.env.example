# =============================================
# VitalMEDS Backend - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vitalmeds?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# AWS General
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3
S3_BUCKET_NAME=vitalmeds-documents

# SES (Simple Email Service)
SES_FROM_EMAIL=noreply@vitalmeds.in
SES_ADMIN_EMAIL=admin@vitalmeds.in

# AWS Cognito
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend
FRONTEND_URL=https://app.vitalmeds.in

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
